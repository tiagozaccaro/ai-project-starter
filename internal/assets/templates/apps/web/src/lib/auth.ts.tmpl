// Authentication helpers for {% .ProjectName%}.
// Adapts to the selected auth provider: {% .AuthProvider%}.

{% if eq .AuthProvider "google-oidc"%}
// FastAPI-managed auth: the backend issues HTTP-only cookies.
// The client only needs to trigger the redirect and read session state.

export function googleLoginUrl(redirect: string): string {
  const base =
    (typeof process !== "undefined" &&
      process.env?.NEXT_PUBLIC_API_URL) ||
    "http://localhost:8000";
  const params = new URLSearchParams({ redirect });
  return `${base}/api/v1/auth/google/login?${params.toString()}`;
}

export async function logout(): Promise<void> {
  const base =
    (typeof process !== "undefined" &&
      process.env?.NEXT_PUBLIC_API_URL) ||
    "http://localhost:8000";
  await fetch(`${base}/api/v1/auth/logout`, { method: "POST" });
}
{% else if eq .AuthProvider "supabase"%}
// Supabase-managed auth: use the Supabase JS client.
// Install @supabase/ssr and configure with NEXT_PUBLIC_SUPABASE_URL.

export async function signInWithGoogle(): Promise<void> {
  throw new Error(
    "Supabase auth requires @supabase/ssr; configure NEXT_PUBLIC_SUPABASE_URL",
  );
}
{% end%}
