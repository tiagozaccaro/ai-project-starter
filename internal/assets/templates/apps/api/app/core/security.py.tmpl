"""Security helpers for {% .ProjectName%}.

Provider: {% .AuthProvider%}.
"""
{% if eq .AuthProvider "google-oidc"%}
import secrets

from authlib.integrations.starlette_client import OAuth
from starlette.config import Config

config = Config(".env")
oauth = OAuth(config)

oauth.register(  # pyright: ignore[reportUnknownMemberType]
    name="google",
    server_metadata_url="https://accounts.google.com/.well-known/openid-configuration",
    client_kwargs={"scope": "openid email profile"},
)


def generate_state() -> str:
    """Generate a cryptographically random OAuth state token."""
    return secrets.token_urlsafe(32)


def create_session_token(claims: dict) -> str:
    """Create a signed session token (JWT, HS256)."""
    from app.core.config import get_settings

    from jose import jwt as jose_jwt

    settings = get_settings()
    return jose_jwt.encode(claims, settings.session_secret, algorithm="HS256")


def verify_session_token(token: str) -> dict | None:
    """Verify a session token and return its claims, or None."""
    from app.core.config import get_settings

    from jose import jwt as jose_jwt

    settings = get_settings()
    try:
        return jose_jwt.decode(
            token, settings.session_secret, algorithms=["HS256"]
        )
    except jose_jwt.JWTError:
        return None


def verify_id_token(id_token: str, client_id: str) -> dict | None:
    """Verify a Google ID token and return its claims, or None."""
    from google.oauth2 import id_token as google_id_token
    from google.auth.transport import requests as google_requests

    try:
        return google_id_token.verify_token(
            id_token,
            request=google_requests.Request(),
            audience=client_id,
        )
    except ValueError:
        return None
{% else if eq .AuthProvider "supabase"%}
import hashlib
import hmac

from jose import jwt as jose_jwt

from app.core.config import get_settings


def verify_supabase_jwt(token: str) -> bool:
    """Verify a Supabase-issued JWT signature.

    Self-hosted Supabase signs access tokens with the project
    JWT secret (HS256). Hosted Supabase uses RS256 with a JWKS
    endpoint; in that case configure the key via environment and
    use the jwks verification path.
    """
    settings = get_settings()
    secret = settings.supabase_anon_key or settings.supabase_service_role_key
    if not token or not secret:
        return False
    try:
        jose_jwt.decode(token, secret, algorithms=["HS256"])
        return True
    except jose_jwt.JWTError:
        return False


def hash_token(token: str) -> str:
    """Return a non-reversible hash of a token for safe logging."""
    return hashlib.sha256(token.encode()).hexdigest()


def constant_time_compare(a: str, b: str) -> bool:
    """Compare two strings in constant time."""
    return hmac.compare_digest(a, b)
{% end%}
