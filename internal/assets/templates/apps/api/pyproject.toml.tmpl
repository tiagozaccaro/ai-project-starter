[project]
name = "{% .ProjectName%}-api"
version = "0.1.0"
description = "{% if .Metadata%}{% if .Metadata.Description%}{% .Metadata.Description%}{% else%}FastAPI backend for {% .ProjectName%}{% end%}{% else%}FastAPI backend for {% .ProjectName%}{% end%}"
requires-python = ">=3.11"
dependencies = [
    "fastapi>=0.111.0",
    "uvicorn[standard]>=0.30.0",
    "pydantic>=2.7.0",
    "pydantic-settings>=2.3.0",
    "sqlalchemy[asyncio]>=2.0.0",
{% if eq .Database.Type "postgresql"%}    "psycopg[binary]>=3.1.0",
{% end%}{% if eq .Database.Type "mysql"%}    "aiomysql>=0.2.0",
{% end%}{% if eq .Database.Type "mongodb"%}    "motor>=3.3.0",
    "beanie>=1.21.0",
{% end%}{% if .GenerateAuth%}    "authlib>=1.3.0",
    "python-jose[cryptography]>=3.3.0",
{% end%}{% if .GenerateAI%}    "openai>=1.35.0",
{% end%}{% if .GenerateWorkers%}    "celery>=5.4.0",
    "redis>=5.0.0",
{% end%}{% if and .GenerateObservability .GenerateAPI%}    "opentelemetry-api>=1.25.0",
    "opentelemetry-sdk>=1.25.0",
{% end%}{% if .GenerateAlembic%}    "alembic>=1.13.0",
{% end%}
]

[dependency-groups]
dev = [
    "pytest>=8.2.0",
    "pytest-asyncio>=0.23.0",
    "pytest-cov>=5.0.0",
    "httpx>=0.27.0",
    "aiosqlite>=0.20.0",
    "ruff>=0.5.0",
    "pyright>=1.1.360",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["app"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
addopts = ["-ra", "--strict-markers"]

[tool.coverage.run]
source = ["app"]
omit = ["*/alembic/*", "*/tests/*"]

[tool.ruff]
line-length = 100
target-version = "py311"
exclude = ["alembic"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]
ignore = ["E501"]

[tool.pyright]
typeCheckingMode = "strict"
include = ["app"]
exclude = ["alembic", "tests"]
