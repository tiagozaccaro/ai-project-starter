"""Authentication endpoint tests."""

import pytest


@pytest.mark.asyncio
async def test_login_initiates(client) -> None:
    """The login endpoint initiates the provider flow."""
    response = await client.post("/api/v1/auth/google/login")
    assert response.status_code == 200
    data = response.json()
    assert data["provider"] == "google"
    assert data["status"] == "initiated"


@pytest.mark.asyncio
async def test_logout_ends_session(client) -> None:
    """The logout endpoint ends the session."""
    response = await client.post("/api/v1/auth/logout")
    assert response.status_code == 200
    assert response.json()["status"] == "logged-out"


@pytest.mark.asyncio
async def test_me_returns_profile(client) -> None:
    """The me endpoint returns a profile."""
    response = await client.get("/api/v1/auth/me")
    assert response.status_code == 200
    assert "email" in response.json()
