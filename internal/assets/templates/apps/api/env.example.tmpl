# API environment variables
# Copy to .env and fill in real values.

# Database connection string (production).
# Tests override this with an in-memory SQLite database.
DATABASE_URL="{% if eq .Database.Type "postgresql"%}postgresql+asyncpg://user:password@localhost:5432/{% .ProjectName%}{% else if eq .Database.Type "sqlite"%}sqlite+aiosqlite:///./app.db{% else if eq .Database.Type "mysql"%}mysql+aiomysql://user:password@localhost:3306/{% .ProjectName%}{% else if eq .Database.Type "mongodb"%}mongodb://localhost:27017/{% .ProjectName%}{% else%}sqlite+aiosqlite:///:memory:{% end%}"

# Application
APP_ENV="development"
APP_DEBUG="true"
SECRET_KEY="change-me-in-production-use-a-long-random-string"

{% if .GenerateAuth%}
# Authentication ({% .AuthProvider%})
{% if eq .AuthProvider "google-oidc"%}GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
OAUTH_CALLBACK_URL="http://localhost:8000/auth/google/callback"
TOKEN_ENCRYPTION_KEY="change-me-in-production-use-a-long-random-string"
{% else if eq .AuthProvider "supabase"%}SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
{% end%}{% end%}
{% if .GenerateObservability%}
# Observability
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
{% end%}
{% if .GenerateAI%}
# AI
OPENAI_API_KEY=""
{% end%}
