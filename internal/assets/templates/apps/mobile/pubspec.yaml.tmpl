name: {% dartPackageName .ProjectName %}
description: A new Flutter project generated by ai-project-starter.
publish_to: "none"
version: 1.0.0+1

environment:
  sdk: ">=3.5.0 <4.0.0"

dependencies:
  flutter:
    sdk: flutter
  go_router: ^14.0.0
  provider: ^6.1.2
  drift: ^2.12.0
  sqlite3_flutter_libs: ^0.5.0
  firebase_messaging: ^14.7.0
  flutter_riverpod: ^2.4.0
  {{ if .GenerateAuth }}
  http: ^1.2.2
  flutter_secure_storage: ^9.2.2
  {{ if eq .AuthProvider "google-oidc" }}
  url_launcher: ^6.3.0
  {{ end }}
  {{ if eq .AuthProvider "supabase" }}
  supabase_flutter: ^2.8.0
  {{ end }}
  {{ end }}

dev_dependencies:
  flutter_test:
    sdk: flutter
  build_runner: ^2.4.0
  flutter_lints: ^4.0.0

flutter:
  uses-material-design: true
