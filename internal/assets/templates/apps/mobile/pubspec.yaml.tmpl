name: {% dartPackageName .ProjectName %}
description: A new Flutter project generated by ai-project-starter.
publish_to: "none"
version: 1.0.0+1

environment:
  sdk: ">=3.5.0 <4.0.0"

dependencies:
  flutter:
    sdk: flutter
  go_router: ^14.0.0
  provider: ^6.1.2
  {% if .GenerateAuth %}
  http: ^1.2.2
  flutter_secure_storage: ^9.2.2
  {% if eq .AuthProvider "google-oidc" %}
  url_launcher: ^6.3.0
  {% endif %}
  {% if eq .AuthProvider "supabase" %}
  supabase_flutter: ^2.8.0
  {% endif %}
  {% endif %}

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0

flutter:
  uses-material-design: true
