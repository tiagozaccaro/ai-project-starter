{
  "schemaVersion": {% .SchemaVersion%},
  "generatorVersion": "{% .GeneratorVersion%}",
  "profile": "{% .Profile%}",
  "projectName": "{% .ProjectName%}",
  "destination": "{% .Destination%}",
  "layout": "{% if .FlatLayout%}flat{% else%}monorepo{% end%}",
  "applications": {
    "web": {% .Applications.Web%},
    "api": {% .Applications.API%},
    "mobile": {% .Applications.Mobile%}
  },
  "database": {
    "type": "{% .Database.Type%}",
    "architecture": "{% .Database.Architecture%}"
  },
  "features": {
    "auth": {% if .GenerateAuth%}["{% .AuthProvider%}"]{% else%}[]{% end%},
    "database.migrations": {% .MigrationsEnabled%},
    "dashboard": {% .GenerateDashboard%},
    "login": {% .GenerateLogin%},
    "charts": {% .GenerateCharts%},
    "graphs": {% .GenerateGraphs%},
    "ai": {% .GenerateAI%},
    "workers": {% .GenerateWorkers%},
    "observability": {% .GenerateObservability%},
    "docker": {% .GenerateDocker%},
    "vscode": {% .GenerateVSCode%},
    "github": {% .GenerateGitHub%},
    "speckit": {% .GenerateSpeckit%},
    "mcp": {% .GenerateMCP%},
    "testing": {% .TestingEnabled%}
  }{% if .Metadata%},
  "metadata": {
    "description": "{% .Metadata.Description%}",
    "author": "{% .Metadata.Author%}",
    "license": "{% .Metadata.License%}",
    "repository": "{% .Metadata.Repository%}"{% if .Metadata.Mobile%},
    "mobile": {
      "bundleId": "{% .Metadata.Mobile.BundleID%}",
      "destinations": [
        {% range $i, $d := .Metadata.Mobile.Destinations %}{% if $i %},{% end %}{"id": "{% $d.ID%}", "label": "{% $d.Label%}", "icon": "{% $d.Icon%}", "route": "{% $d.Route%}"}{% end %}
      ],
      "leftDrawerItems": [
        {% range $i, $item := .Metadata.Mobile.LeftDrawerItems %}{% if $i %},{% end %}{"id": "{% $item.ID%}", "label": "{% $item.Label%}", "icon": "{% $item.Icon%}", "route": "{% $item.Route%}"}{% end %}
      ],
      "rightDrawerItems": [
        {% range $i, $item := .Metadata.Mobile.RightDrawerItems %}{% if $i %},{% end %}{"id": "{% $item.ID%}", "label": "{% $item.Label%}", "icon": "{% $item.Icon%}", "route": "{% $item.Route%}"}{% end %}
      ]{% if .Metadata.Mobile.Theme%},
      "theme": {
        "primaryColor": "{% .Metadata.Mobile.Theme.PrimaryColor%}",
        "darkMode": {% .Metadata.Mobile.Theme.DarkMode%},
        "useMaterial3": {% .Metadata.Mobile.Theme.UseMaterial3%}
      }{% end %}
    }{% end %}
  }{% end %}
}
