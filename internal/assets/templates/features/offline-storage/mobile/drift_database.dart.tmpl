import 'dart:async';
import 'package:drift/drift.dart';
import 'package:drift/native.dart';
import 'package:path_provider/path_provider.dart';
import 'package:sqlite3/sqlite3.dart';
import 'package:path/path.dart' show join;

// Database tables for {% .ProjectName%} offline storage.
// Uses Drift ORM for type-safe SQLite access.

@DataClassName('OfflineEntity')
class OfflineEntities extends Table {
  TextColumn get id => text().withLength(255)();
  JsonColumn get value => json().named('value')();
  DateTimeColumn get createdAt => dateTime().clientDefault(() => DateTime.now())();
  DateTimeColumn get updatedAt => dateTime().clientDefault(() => DateTime.now()).withUpdate(() => DateTime.now())();
}

@DataClassName('SyncMetadata')
class SyncMetadataTable extends Table {
  TextColumn get entityType => text().withLength(100)();
  IntColumn get lastSyncTimestamp => integer()();
  IntColumn get pendingChanges => integer()();
}

@DataClassName('PendingMutation')
class PendingMutationsTable extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get entityType => text().withLength(100)();
  TextColumn get operation => text().withLength(20)(); // create, update, delete
  TextColumn get entityId => text().withLength(255)();
  JsonColumn get entityData => json().named('entityData')();
  IntColumn get timestamp => integer()();
  IntColumn get retryCount => integer().withDefault(const Constant(0))();
}

@DriftDatabase(
  tables: [
    OfflineEntities,
    SyncMetadataTable,
    PendingMutationsTable
  ]
)
class OfflineDatabase extends _$OfflineDatabase {
  OfflineDatabase() : super(_openConnection());

  @override
  int get schemaVersion => 1;

  // DAO methods for offline entities
  Future<OfflineEntity?> getOfflineEntity(String id) =>
      (select(offlineEntities)..where((t) => t.id.equals(id))).getSingleOrNull();

  Future<List<OfflineEntity>> getAllOfflineEntities() =>
      select(offlineEntities).get();

  Future<void> saveOfflineEntity(OfflineEntity entity) =>
      into(offlineEntities).insertOnUpdateReplace(entity);

  Future<void> deleteOfflineEntity(String id) =>
      (delete(offlineEntities)..where((t) => t.id.equals(id))).go();

  // DAO methods for sync metadata
  Future<SyncMetadata?> getSyncMetadata(String entityType) =>
      (select(syncMetadataTable)
            ..where((t) => t.entityType.equals(entityType)))
          .getSingleOrNull();

  Future<void> saveSyncMetadata(SyncMetadata metadata) =>
      into(syncMetadataTable).insertOnUpdateReplace(metadata);

  // DAO methods for pending mutations
  Future<PendingMutation?> getPendingMutation(int id) =>
      (select(pendingMutationsTable)..where((t) => t.id.equals(id)))
          .getSingleOrNull();

  Future<List<PendingMutation>> getPendingMutations() =>
      select(pendingMutationsTable).get();

  Future<void> savePendingMutation(PendingMutation mutation) =>
      into(pendingMutationsTable).insert(mutation);

  Future<void> deletePendingMutation(int id) =>
      (delete(pendingMutationsTable)..where((t) => t.id.equals(id))).go();

  Future<List<PendingMutation>> getPendingMutationsByEntityType(
      String entityType) =>
      (select(pendingMutationsTable)
            ..where((t) => t.entityType.equals(entityType)))
          .get();
}

// Open database connection
LazyDatabase _openConnection() {
  // Use the document directory for Android/iOS, or current directory for desktop
  return LazyDatabase(() async {
    final dbFolder = await getApplicationDocumentsDirectory();
    final file = File(join(dbFolder.path, 'offline_storage.db'));
    return NativeDatabase(file);
  });
}
