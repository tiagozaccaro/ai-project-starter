import 'package:flutter/foundation.dart';

enum ConflictResolutionStrategy {
  lastWriteWins,
  serverWins,
  clientWins,
  manual
}

class ConflictResolutionResult {
  final dynamic resolvedData;
  final bool requiresManual;

  ConflictResolutionResult({
    required this.resolvedData,
    required this.requiresManual,
  });
}

ConflictResolutionResult resolveConflict(
  String entityId,
  dynamic clientData,
  dynamic serverData,
  ConflictResolutionStrategy strategy,
) {
  switch (strategy) {
    case ConflictResolutionStrategy.serverWins:
      return ConflictResolutionResult(resolvedData: serverData, requiresManual: false);
    case ConflictResolutionStrategy.clientWins:
      return ConflictResolutionResult(resolvedData: clientData, requiresManual: false);
    case ConflictResolutionStrategy.manual:
      return ConflictResolutionResult(resolvedData: null, requiresManual: true);
    case ConflictResolutionStrategy.lastWriteWins:
    default:
      // Compare timestamps for last-write-wins
      final clientTime = clientData is Map 
        ? (clientData['updatedAt'] ?? clientData['createdAt'] ?? 0)
        : 0;
      final serverTime = serverData is Map 
        ? (serverData['updatedAt'] ?? serverData['createdAt'] ?? 0)
        : 0;
      
      if (clientTime >= serverTime) {
        return ConflictResolutionResult(resolvedData: clientData, requiresManual: false);
      } else {
        return ConflictResolutionResult(resolvedData: serverData, requiresManual: false);
      }
  }
}

bool detectConflict(dynamic clientData, dynamic serverData) {
  if (clientData == null || serverData == null) return false;
  
  // Simple conflict detection: both have data and they're different
  return clientData.toString() != serverData.toString();
}

Map<String, dynamic> createConflictRecord(
  String entityId,
  String entityType,
  dynamic clientData,
  dynamic serverData,
) {
  return {
    'entityId': entityId,
    'entityType': entityType,
    'clientData': clientData,
    'serverData': serverData,
    'clientTimestamp': clientData is Map ? (clientData['updatedAt'] ?? clientData['createdAt']) : null,
    'serverTimestamp': serverData is Map ? (serverData['updatedAt'] ?? serverData['createdAt']) : null,
    'detectedAt': DateTime.now().millisecondsSinceEpoch,
  };
}