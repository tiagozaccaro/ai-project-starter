import 'dart:async';
import 'dart:convert';
import 'package:http/http.dart' as http;

import 'package:flutter/foundation.dart';
import 'package:workmanager/workmanager.dart';

// Offline mutation queue for {% .ProjectName%}.
// Queues mutations when offline and replays them when connectivity is restored.
// Uses WorkManager for background processing.

import 'drift_database.dart';

class OfflineQueue {
  final OfflineDatabase _db;
  final String _apiBaseUrl;

  OfflineQueue({
    required OfflineDatabase db,
    required String apiBaseUrl,
  })  : _db = db,
        _apiBaseUrl = apiBaseUrl;

  // Queue configuration
  static const String _taskName = 'offlineQueueTask';
  static const String _actionProcessQueue = 'processOfflineQueue';
  
  final int _maxRetries = 5;
  final int _baseDelayMs = 1000;

  /**
   * Initialize the offline queue.
   * Sets up the background task handler.
   */
  Future<void> initialize() async {
    await Workmanager().initialize(
      // The top-level function, i.e. the callback
      (String taskName, Map<String, dynamic>? inputData) async {
        switch (taskName) {
          case _actionProcessQueue:
            await _processQueue();
            break;
        }
        return Future.value(true);
      },
    );
    
    // Register the periodic task
    await Workmanager().registerPeriodicTask(
      'offline-queue-processing',
      _taskName,
      frequency: const Duration(minutes: 15),
      constraints: Constraints(
        networkType: NetworkType.connected, // Only run when connected
      ),
    );
  }

  /**
   * Add a mutation to the offline queue.
   * @param entityType - Type of entity
   * @param operation - Type of mutation (create/update/delete)
   * @param entityId - ID of the entity
   * @param entityData - Entity data (for create/update) or null (for delete)
   * @returns Future completing when mutation is queued
   */
  Future<void> queueMutation({
    required String entityType,
    required String operation, // 'create', 'update', 'delete'
    required String entityId,
    required Map<String, dynamic>? entityData,
  }) async {
    final mutation = PendingMutation(
      id: 0, // Will be auto-generated
      entityType: entityType,
      operation: operation,
      entityId: entityId,
      entityData: entityData != null ? json.encode(entityData) : null,
      timestamp: DateTime.now().millisecondsSinceEpoch,
      retryCount: 0,
    );

    await _db.savePendingMutation(mutation);
    
    // Update pending changes count for this entity type
    final metadata = await _db.getSyncMetadata(entityType);
    if (metadata != null) {
      await _db.saveSyncMetadata(
        metadata.copyWith(
          pendingChanges: metadata.pendingChanges + 1,
        ),
      );
    }
    
    // If we're online, try to process the queue immediately
    if (await _isOnline()) {
      await _processQueue();
    }
  }

  /**
   * Process the offline mutation queue.
   * Attempts to send all queued mutations to the server.
   * @returns Future completing when queue processing is done
   */
  Future<void> _processQueue() async {
    // Check if we're online
    if (!(await _isOnline())) {
      // If we're offline, just return - we'll try again when online or via background task
      return;
    }
    
    final pendingMutations = await _db.getPendingMutations();
    
    if (pendingMutations.isEmpty) {
      return; // Nothing to process
    }
    
    // Process mutations in order
    for (final mutation in pendingMutations) {
      try {
        bool success = false;
        
        switch (mutation.operation) {
          case 'create':
            if (mutation.entityData != null) {
              final response = await _makeApiRequest(
                'POST',
                '/api/${mutation.entityType}',
                json.decode(mutation.entityData!),
              );
              success = true;
            }
            break;
            
          case 'update':
            if (mutation.entityId != null && mutation.entityData != null) {
              final response = await _makeApiRequest(
                'PUT',
                '/api/${mutation.entityType}/${mutation.entityId}',
                json.decode(mutation.entityData!),
              );
              success = true;
            }
            break;
            
          case 'delete':
            if (mutation.entityId != null) {
              final response = await _makeApiRequest(
                'DELETE',
                '/api/${mutation.entityType}/${mutation.entityId}',
                null,
              );
              success = true;
            }
            break;
        }
        
        if (success) {
          // Remove successful mutation from queue
          await _db.deletePendingMutation(mutation.id);
          
          // Update pending changes count
          final metadata = await _db.getSyncMetadata(mutation.entityType);
          if (metadata != null) {
            await _db.saveSyncMetadata(
              metadata.copyWith(
                pendingChanges: metadata.pendingChanges - 1,
              ),
            );
          }
        } else {
          // Handle failed mutation
          await _handleFailedMutation(mutation);
        }
      } catch (e) {
        if (kDebugMode) {
          print('Failed to process mutation ${mutation.id}: $e');
        }
        await _handleFailedMutation(mutation);
      }
    }
  }

  Future<dynamic> _makeApiRequest(
      String method,
      String endpoint,
      dynamic body,
      ) async {
    final url = Uri.parse('$_apiBaseUrl$endpoint');
    
    final request = http.Request(method, url);
    request.headers['Content-Type'] = 'application/json';
    
    if (body != null) {
      request.body = json.encode(body);
    }
    
    final response = await http.Client().send(request);
    final responseBody = await response.stream.bytesToString();
    
    if (response.statusCode >= 200 && response.statusCode < 300) {
      return json.decode(responseBody);
    } else {
      throw Exception('API request failed: ${response.statusCode}');
    }
  }

  /**
   * Handle a failed mutation attempt.
   * Increments retry count and re-queues if within retry limits.
   * @param mutation - The failed mutation
   */
  Future<void> _handleFailedMutation(PendingMutation mutation) async {
    final updatedMutation = mutation.copyWith(
      retryCount: mutation.retryCount + 1,
    );
    
    if (updatedMutation.retryCount <= _maxRetries) {
      // Re-queue with updated retry count
      await _db.savePendingMutation(updatedMutation);
      
      // Schedule retry with exponential backoff
      // Note: In a real app, you might want to use a more sophisticated scheduling approach
      final delay = _baseDelayMs * (1 << (updatedMutation.retryCount - 1));
      Future.delayed(Duration(milliseconds: delay), () async {
        if (await _isOnline()) {
          await _processQueue();
        }
      });
    } else {
      // Max retries exceeded - remove from queue and log error
      await _db.deletePendingMutation(mutation.id);
      if (kDebugMode) {
        print('Max retries exceeded for mutation ${mutation.id}');
      }
    }
  }

  /**
   * Check if the device is currently online.
   * @returns True if online, false if offline
   */
  Future<bool> _isOnline() async {
    try {
      final response = await http.Client()
          .get(Uri.parse('https://api.example.com/health'), timeout: const Duration(seconds: 5));
      return response.statusCode == 200;
    } catch (_) {
      return false;
    }
  }
}

/**
 * Extension to add copyWith method to PendingMutation.
 */
extension PendingMutationCopyWith on PendingMutation {
  PendingMutation copyWith({
    int? id,
    String? entityType,
    String? operation,
    String? entityId,
    String? entityData,
    int? timestamp,
    int? retryCount,
  }) {
    return PendingMutation(
      id: id ?? this.id,
      entityType: entityType ?? this.entityType,
      operation: operation ?? this.operation,
      entityId: entityId ?? this.entityId,
      entityData: entityData ?? this.entityData,
      timestamp: timestamp ?? this.timestamp,
      retryCount: retryCount ?? this.retryCount,
    );
  }
}
