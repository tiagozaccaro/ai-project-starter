import 'dart:async';
import 'package:flutter/foundation.dart';
import 'drift_database.dart';

class OfflineQueue {
  final OfflineDatabase database;

  OfflineQueue({required this.database});

  Future<void> add({
    required String entityType,
    required String operation,
    required String entityId,
    Map<String, dynamic>? entityData,
  }) async {
    final mutation = PendingMutation(
      id: 0, // Will be auto-generated
      entityType: entityType,
      operation: operation,
      entityId: entityId,
      entityData: entityData,
      timestamp: DateTime.now().millisecondsSinceEpoch,
      retryCount: 0,
    );
    await database.savePendingMutation(mutation);
  }

  Future<void> process({
    required String entityType,
    required Future<void> Function(List<dynamic>) syncPush,
  }) async {
    final mutations = await database.getPendingMutationsByEntityType(entityType);
    if (mutations.isEmpty) return;

    try {
      await syncPush(mutations);
      // Note: Actual removal of synced mutations happens in syncPush after server response
    } catch (e) {
      if (kDebugMode) {
        print('Error processing queue for $entityType: $e');
      }
      // Increment retry counts
      for (final mutation in mutations) {
        if (mutation.id != null) {
          await database.deletePendingMutation(mutation.id!);
          // Re-add with incremented retry count
          await add(
            entityType: mutation.entityType,
            operation: mutation.operation,
            entityId: mutation.entityId,
            entityData: mutation.entityData,
          );
        }
      }
      rethrow;
    }
  }

  Future<List<PendingMutation>> getQueue(String entityType) async {
    return database.getPendingMutationsByEntityType(entityType);
  }

  Future<int> getQueueSize(String entityType) async {
    final mutations = await database.getPendingMutationsByEntityType(entityType);
    return mutations.length;
  }

  Future<void> clearQueue(String entityType) async {
    final mutations = await database.getPendingMutationsByEntityType(entityType);
    for (final mutation in mutations) {
      if (mutation.id != null) {
        await database.deletePendingMutation(mutation.id!);
      }
    }
  }

  Future<void> retryFailedMutations(String entityType) async {
    final mutations = await database.getPendingMutationsByEntityType(entityType);
    final failedMutations = mutations.where((m) => m.retryCount > 0).toList();
    
    for (final mutation in failedMutations) {
      if (mutation.id != null) {
        await database.deletePendingMutation(mutation.id!);
      }
    }
  }
}