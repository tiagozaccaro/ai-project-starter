import 'dart:async';
import 'dart:convert';
import 'package:flutter/foundation.dart';
import 'package:http/http.dart' as http;
import 'drift_database.dart';

class SyncEngine {
  final OfflineDatabase database;
  final String apiBaseUrl;

  SyncEngine({
    required this.database,
    required this.apiBaseUrl,
  });

  Future<void> pushMutations(String entityType) async {
    try {
      final mutations = await database.getPendingMutationsByEntityType(entityType);
      if (mutations.isEmpty) return;

      // Convert mutations to JSON
      final mutationData = mutations.map((m) => {
        'id': m.id,
        'entityType': m.entityType,
        'operation': m.operation,
        'entityId': m.entityId,
        'entityData': m.entityData,
        'timestamp': m.timestamp,
      }).toList();

      final response = await http.post(
        Uri.parse('$apiBaseUrl/api/v1/sync/$entityType/push'),
        headers: {'Content-Type': 'application/json'},
        body: jsonEncode({'mutations': mutationData}),
      );

      if (response.statusCode != 200 && response.statusCode != 201) {
        throw Exception('Sync push failed: ${response.statusCode}');
      }

      final result = jsonDecode(response.body);
      final conflicts = result['conflicts'] as List<dynamic>? ?? [];
      final serverTimestamp = result['serverTimestamp'] as int? ?? DateTime.now().millisecondsSinceEpoch;

      // Handle conflicts
      for (final conflict in conflicts) {
        final strategy = ConflictResolutionStrategy.lastWriteWins; // TODO: Get from config
        final resolvedData = resolveConflict(
          conflict['entityId'],
          conflict['clientData'],
          conflict['serverData'],
          strategy,
        );

        if (resolvedData != null) {
          // Apply resolved data locally
          await database.saveOfflineEntity(OfflineEntity(
            id: conflict['entityId'],
            value: resolvedData,
            createdAt: DateTime.now(),
            updatedAt: DateTime.now(),
          ));
        }
        // If null, manual resolution needed
      }

      // Remove successfully synced mutations
      for (final mutation in mutations) {
        final hasUnresolvedConflict = conflicts.any((c) => 
          c['entityId'] == mutation.entityId && c['manualResolutionNeeded'] == true
        );
        if (!hasUnresolvedConflict) {
          await database.deletePendingMutation(mutation.id!);
        }
      }

      // Update sync metadata
      final metadata = await database.getSyncMetadata(entityType);
      if (metadata != null) {
        metadata.lastSyncTimestamp = serverTimestamp;
        metadata.pendingChanges = (metadata.pendingChanges - mutations.length + conflicts.length).clamp(0, 999999);
        await database.saveSyncMetadata(metadata);
      }
    } catch (e) {
      if (kDebugMode) {
        print('Sync push failed for $entityType: $e');
      }
      rethrow;
    }
  }

  Future<List<dynamic>> pullChanges(String entityType) async {
    try {
      final metadata = await database.getSyncMetadata(entityType);
      final since = metadata?.lastSyncTimestamp ?? 0;

      final response = await http.get(
        Uri.parse('$apiBaseUrl/api/v1/sync/$entityType/pull?since=$since'),
      );

      if (response.statusCode != 200) {
        throw Exception('Sync pull failed: ${response.statusCode}');
      }

      final result = jsonDecode(response.body);
      final entities = result['entities'] as List<dynamic>? ?? [];
      final serverTimestamp = result['serverTimestamp'] as int? ?? DateTime.now().millisecondsSinceEpoch;

      // Apply pulled entities to local storage
      for (final entity in entities) {
        final existing = await database.getOfflineEntity(entity['id'] as String);
        if (existing != null) {
          // Check for conflicts
          final strategy = ConflictResolutionStrategy.lastWriteWins; // TODO: Get from config
          final resolvedData = resolveConflict(
            entity['id'],
            entity['value'],
            existing.value,
            strategy,
          );
          if (resolvedData != null) {
            await database.saveOfflineEntity(OfflineEntity(
              id: entity['id'],
              value: resolvedData,
              createdAt: existing.createdAt,
              updatedAt: DateTime.now(),
            ));
          }
        } else {
          await database.saveOfflineEntity(OfflineEntity(
            id: entity['id'],
            value: entity['value'],
            createdAt: DateTime.now(),
            updatedAt: DateTime.now(),
          ));
        }
      }

      // Update sync metadata
      if (metadata != null) {
        metadata.lastSyncTimestamp = serverTimestamp;
        metadata.pendingChanges = entities.length;
        await database.saveSyncMetadata(metadata);
      }

      return entities;
    } catch (e) {
      if (kDebugMode) {
        print('Sync pull failed for $entityType: $e');
      }
      rethrow;
    }
  }

  Future<void> syncAll(List<String> entityTypes) async {
    for (final entityType in entityTypes) {
      await pushMutations(entityType);
      await pullChanges(entityType);
    }
  }
}