// Offline mutation queue for {% .ProjectName%}.
// Queues mutations when offline and replays them when connectivity is restored.
// Implements exponential backoff retry mechanism.

import { queueMutation, getPendingMutations, removePendingMutation } from './sync-engine';
import { getDB } from './indexeddb';

interface QueueOptions {
  maxRetries: number;
  baseDelayMs: number;
}

const DEFAULT_OPTIONS: QueueOptions = {
  maxRetries: 5,
  baseDelayMs: 1000
};

/**
 * Check if the browser is currently online.
 * @returns True if online, false if offline
 */
export function isOnline(): boolean {
  return navigator.onLine;
}

/**
 * Add a mutation to the offline queue.
 * @param entityType - Type of entity
 * @param operation - Type of mutation (create/update/delete)
 * @param entityId - ID of the entity
 * @param entityData - Entity data (for create/update) or null (for delete)
 * @returns Promise resolving when mutation is queued
 */
export async function queueOfflineMutation(
  entityType: string,
  operation: 'create' | 'update' | 'delete',
  entityId: string,
  entityData: unknown = null
): Promise<void> {
  await queueMutation(entityType, operation, entityId, entityData);
  
  // If we're online, try to process the queue immediately
  if (isOnline()) {
    await processOfflineQueue();
  }
}

/**
 * Process the offline mutation queue.
 * Attempts to send all queued mutations to the server.
 * @param apiClient - API client for making requests
 * @param options - Queue processing options
 * @returns Promise resolving when queue processing is complete
 */
export async function processOfflineQueue(
  apiClient: {
    createEntity: (entityType: string, data: unknown) => Promise<unknown>;
    updateEntity: (entityType: string, id: string, data: unknown) => Promise<unknown>;
    deleteEntity: (entityType: string, id: string) => Promise<unknown>;
  },
  options: QueueOptions = DEFAULT_OPTIONS
): Promise<void> {
  if (!isOnline()) {
    // If we're offline, just return - we'll try again when online
    return;
  }
  
  const pendingMutations = await getPendingMutations();
  
  if (pendingMutations.length === 0) {
    return; // Nothing to process
  }
  
  // Process mutations in order
  for (const mutation of pendingMutations) {
    try {
      let success = false;
      
      switch (mutation.operation) {
        case 'create':
          if (mutation.entityData) {
            await apiClient.createEntity(mutation.entityType, mutation.entityData);
            success = true;
          }
          break;
          
        case 'update':
          if (mutation.entityId && mutation.entityData) {
            await apiClient.updateEntity(
              mutation.entityType,
              mutation.entityId,
              mutation.entityData
            );
            success = true;
          }
          break;
          
        case 'delete':
          if (mutation.entityId) {
            await apiClient.deleteEntity(mutation.entityType, mutation.entityId);
            success = true;
          }
          break;
      }
      
      if (success) {
        // Remove successful mutation from queue
        await removePendingMutation(mutation.id);
      } else {
        // Handle failed mutation
        await handleFailedMutation(mutation, options);
      }
    } catch (error) {
      console.error(`Failed to process mutation ${mutation.id}:`, error);
      await handleFailedMutation(mutation, options);
    }
  }
}

/**
 * Handle a failed mutation attempt.
 * Increments retry count and re-queues if within retry limits.
 * @param mutation - The failed mutation
 * @param options - Queue processing options
 */
async function handleFailedMutation(
  mutation: PendingMutation,
  options: QueueOptions
): Promise<void> {
  const db = await getDB();
  const tx = db.transaction('pending_mutations', 'readwrite');
  const store = tx.objectStore('pending_mutations');
  
  // Get the current mutation to update retry count
  const currentMutation = await store.get(mutation.id);
  
  if (currentMutation) {
    const updatedMutation = {
      ...currentMutation,
      retryCount: currentMutation.retryCount + 1
    };
    
    if (updatedMutation.retryCount <= options.maxRetries) {
      // Re-queue with updated retry count
      await store.put(updatedMutation);
      
      // Schedule retry with exponential backoff
      const delay = options.baseDelayMs * Math.pow(2, updatedMutation.retryCount - 1);
      setTimeout(async () => {
        if (isOnline()) {
          await processOfflineQueue(apiClient, options);
        }
      }, delay);
    } else {
      // Max retries exceeded - remove from queue and log error
      await store.delete(mutation.id);
      console.error(`Max retries exceeded for mutation ${mutation.id}`);
    }
  }
  
  await tx.done;
}

/**
 * Set up event listeners for online/offline events.
 * @param apiClient - API client for making requests
 * @param options - Queue processing options
 */
export function setupOfflineQueueListeners(
  apiClient: {
    createEntity: (entityType: string, data: unknown) => Promise<unknown>;
    updateEntity: (entityType: string, id: string, data: unknown) => Promise<unknown>;
    deleteEntity: (entityType: string, id: string) => Promise<unknown>;
  },
  options: QueueOptions = DEFAULT_OPTIONS
): () => void {
  const handleOnline = async () => {
    await processOfflineQueue(apiClient, options);
  };
  
  window.addEventListener('online', handleOnline);
  
  // Also check periodically in case the online event is missed
  const checkInterval = setInterval(() => {
    if (isOnline()) {
      processOfflineQueue(apiClient, options);
    }
  }, 30000); // Check every 30 seconds
  
  // Return cleanup function
  return () => {
    window.removeEventListener('online', handleOnline);
    clearInterval(checkInterval);
  };
}
