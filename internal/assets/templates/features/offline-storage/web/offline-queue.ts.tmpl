import { useOfflineStorage } from './use-offline-storage';
import { useCallback, useEffect, useState } from 'react';

interface Mutation {
  id: number;
  entityType: string;
  operation: 'create' | 'update' | 'delete';
  entityId: string;
  entityData: any;
  timestamp: number;
  retryCount: number;
}

export function useOfflineQueue() {
  const { db } = useOfflineStorage();
  const [queue, setQueue] = useState<Mutation[]>([]);
  const [isLoading, setIsLoading] = useState(false);

  const loadQueue = useCallback(async (entityType?: string) => {
    if (!db) return;
    setIsLoading(true);
    try {
      const tx = db.transaction('pendingMutations', 'readonly');
      const store = tx.objectStore('pendingMutations');
      let mutations: Mutation[];
      
      if (entityType) {
        const index = store.index('by-entity-type');
        mutations = await index.getAll(entityType);
      } else {
        mutations = await store.getAll();
      }
      
      await tx.done;
      setQueue(mutations);
    } catch (error) {
      console.error('Failed to load offline queue:', error);
    } finally {
      setIsLoading(false);
    }
  }, [db]);

  useEffect(() => {
    loadQueue();
  }, [loadQueue]);

  const addToQueue = useCallback(async (mutation: Omit<Mutation, 'id' | 'retryCount'>) => {
    if (!db) return;
    
    const newMutation: Mutation = {
      ...mutation,
      id: Date.now(), // Simple ID generation
      retryCount: 0,
      timestamp: mutation.timestamp || Date.now(),
    };

    try {
      const tx = db.transaction('pendingMutations', 'readwrite');
      const store = tx.objectStore('pendingMutations');
      await store.put(newMutation);
      await tx.done;
      
      setQueue(prev => [...prev, newMutation]);
    } catch (error) {
      console.error('Failed to add to offline queue:', error);
    }
  }, [db]);

  const removeFromQueue = useCallback(async (id: number) => {
    if (!db) return;
    
    try {
      const tx = db.transaction('pendingMutations', 'readwrite');
      const store = tx.objectStore('pendingMutations');
      await store.delete(id);
      await tx.done;
      
      setQueue(prev => prev.filter(m => m.id !== id));
    } catch (error) {
      console.error('Failed to remove from offline queue:', error);
    }
  }, [db]);

  const incrementRetryCount = useCallback(async (id: number) => {
    if (!db) return;
    
    try {
      const tx = db.transaction('pendingMutations', 'readwrite');
      const store = tx.objectStore('pendingMutations');
      const mutation = await store.get(id);
      if (mutation) {
        mutation.retryCount += 1;
        await store.put(mutation);
        await tx.done;
        
        setQueue(prev => prev.map(m => 
          m.id === id ? { ...m, retryCount: m.retryCount + 1 } : m
        ));
      }
    } catch (error) {
      console.error('Failed to increment retry count:', error);
    }
  }, [db]);

  const clearQueue = useCallback(async (entityType?: string) => {
    if (!db) return;
    
    try {
      const tx = db.transaction('pendingMutations', 'readwrite');
      const store = tx.objectStore('pendingMutations');
      
      if (entityType) {
        const index = store.index('by-entity-type');
        const mutations = await index.getAll(entityType);
        for (const mutation of mutations) {
          await store.delete(mutation.id);
        }
      } else {
        await store.clear();
      }
      
      await tx.done;
      setQueue(prev => entityType ? prev.filter(m => m.entityType !== entityType) : []);
    } catch (error) {
      console.error('Failed to clear offline queue:', error);
    }
  }, [db]);

  const getQueueByEntityType = useCallback((entityType: string) => {
    return queue.filter(m => m.entityType === entityType);
  }, [queue]);

  const getQueueSize = useCallback(() => queue.length, [queue]);

  return {
    queue,
    isLoading,
    loadQueue,
    addToQueue,
    removeFromQueue,
    incrementRetryCount,
    clearQueue,
    getQueueByEntityType,
    getQueueSize,
  };
}