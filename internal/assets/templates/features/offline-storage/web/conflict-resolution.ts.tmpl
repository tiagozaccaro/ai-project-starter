export enum ConflictResolutionStrategy {
  LAST_WRITE_WINS = 'last-write-wins',
  SERVER_WINS = 'server-wins',
  CLIENT_WINS = 'client-wins',
  MANUAL = 'manual',
}

export interface EntityWithTimestamp {
  value: any;
  createdAt?: number;
  updatedAt?: number;
  [key: string]: any;
}

export function resolveConflict(
  entityId: string,
  clientData: EntityWithTimestamp,
  serverData: EntityWithTimestamp,
  strategy: ConflictResolutionStrategy
): { resolvedData: any; requiresManual: boolean } {
  switch (strategy) {
    case ConflictResolutionStrategy.SERVER_WINS:
      return { resolvedData: serverData.value, requiresManual: false };
    
    case ConflictResolutionStrategy.CLIENT_WINS:
      return { resolvedData: clientData.value, requiresManual: false };
    
    case ConflictResolutionStrategy.MANUAL:
      return { 
        resolvedData: null, 
        requiresManual: true 
      };
    
    case ConflictResolutionStrategy.LAST_WRITE_WINS:
    default:
      // Compare timestamps for last-write-wins
      const clientTime = clientData.updatedAt || clientData.createdAt || 0;
      const serverTime = serverData.updatedAt || serverData.createdAt || 0;
      
      if (clientTime >= serverTime) {
        return { resolvedData: clientData.value, requiresManual: false };
      } else {
        return { resolvedData: serverData.value, requiresManual: false };
      }
  }
}

export function detectConflict(
  clientData: EntityWithTimestamp,
  serverData: EntityWithTimestamp
): boolean {
  // Simple conflict detection: both have data and they're different
  if (!clientData || !serverData) return false;
  
  // If both have values, check if they're deeply equal
  return JSON.stringify(clientData.value) !== JSON.stringify(serverData.value);
}

export function createConflictRecord(
  entityId: string,
  entityType: string,
  clientData: EntityWithTimestamp,
  serverData: EntityWithTimestamp
) {
  return {
    entityId,
    entityType,
    clientData: clientData.value,
    serverData: serverData.value,
    clientTimestamp: clientData.updatedAt || clientData.createdAt,
    serverTimestamp: serverData.updatedAt || serverData.createdAt,
    detectedAt: Date.now(),
  };
}