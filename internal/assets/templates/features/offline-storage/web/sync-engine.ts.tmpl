import { useOfflineStorage } from './use-offline-storage';
import { useCallback, useEffect, useRef } from 'react';
import { ConflictResolutionStrategy } from '@/utils/conflict-resolution';

interface Mutation {
  id: number;
  entityType: string;
  operation: 'create' | 'update' | 'delete';
  entityId: string;
  entityData: any;
  timestamp: number;
  retryCount: number;
}

interface SyncMetadata {
  entityType: string;
  lastSyncTimestamp: number;
  pendingChanges: number;
}

export function useSyncEngine() {
  const { saveData, getData, updateData, deleteData, db } = useOfflineStorage();
  const isSyncingRef = useRef(false);

  const getSyncMetadata = useCallback(async (entityType: string): Promise<SyncMetadata | null> => {
    if (!db) return null;
    const tx = db.transaction('syncMetadata', 'readonly');
    const store = tx.objectStore('syncMetadata');
    const metadata = await store.get(entityType);
    await tx.done;
    return metadata || null;
  }, [db]);

  const updateSyncMetadata = useCallback(async (metadata: SyncMetadata) => {
    if (!db) return;
    const tx = db.transaction('syncMetadata', 'readwrite');
    const store = tx.objectStore('syncMetadata');
    await store.put(metadata);
    await tx.done;
  }, [db]);

  const getPendingMutations = useCallback(async (entityType: string): Promise<Mutation[]> => {
    if (!db) return [];
    const tx = db.transaction('pendingMutations', 'readonly');
    const store = tx.objectStore('pendingMutations');
    const index = store.index('by-entity-type');
    const mutations = await index.getAll(entityType);
    await tx.done;
    return mutations;
  }, [db]);

  const savePendingMutation = useCallback(async (mutation: Mutation) => {
    if (!db) return;
    const tx = db.transaction('pendingMutations', 'readwrite');
    const store = tx.objectStore('pendingMutations');
    await store.put(mutation);
    await tx.done;
  }, [db]);

  const deletePendingMutation = useCallback(async (id: number) => {
    if (!db) return;
    const tx = db.transaction('pendingMutations', 'readwrite');
    const store = tx.objectStore('pendingMutations');
    await store.delete(id);
    await tx.done;
  }, [db]);

  const applyConflictResolution = useCallback((
    clientData: any,
    serverData: any,
    strategy: ConflictResolutionStrategy
  ): any => {
    switch (strategy) {
      case ConflictResolutionStrategy.SERVER_WINS:
        return serverData;
      case ConflictResolutionStrategy.CLIENT_WINS:
        return clientData;
      case ConflictResolutionStrategy.MANUAL:
        return null; // Indicates manual resolution needed
      case ConflictResolutionStrategy.LAST_WRITE_WINS:
      default:
        // Compare timestamps if available
        if (clientData?.updatedAt && serverData?.updatedAt) {
          return clientData.updatedAt >= serverData.updatedAt ? clientData : serverData;
        }
        if (clientData?.createdAt && serverData?.createdAt) {
          return clientData.createdAt >= serverData.createdAt ? clientData : serverData;
        }
        return serverData;
    }
  }, []);

  const syncPush = useCallback(async (entityType: string, apiBaseUrl: string): Promise<{ success: boolean; conflicts: any[] }> => {
    if (isSyncingRef.current) return { success: false, conflicts: [] };
    isSyncingRef.current = true;

    try {
      const mutations = await getPendingMutations(entityType);
      if (mutations.length === 0) {
        return { success: true, conflicts: [] };
      }

      const response = await fetch(`${apiBaseUrl}/api/v1/sync/${entityType}/push`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ mutations }),
      });

      if (!response.ok) {
        throw new Error(`Sync push failed: ${response.status}`);
      }

      const result = await response.json();
      const conflicts = result.conflicts || [];

      // Handle conflicts
      for (const conflict of conflicts) {
        const strategy = ConflictResolutionStrategy.LAST_WRITE_WINS; // TODO: Get from config
        const resolvedData = applyConflictResolution(conflict.clientData, conflict.serverData, strategy);
        
        if (resolvedData !== null) {
          // Apply resolved data locally
          await updateData(entityType, conflict.entityId, resolvedData);
        }
        // If null, manual resolution needed - keep in queue for manual handling
      }

      // Remove successfully synced mutations
      for (const mutation of mutations) {
        // Check if this mutation had a conflict that wasn't manually resolved
        const hasUnresolvedConflict = conflicts.some((c: any) => c.entityId === mutation.entityId && c.manualResolutionNeeded);
        if (!hasUnresolvedConflict) {
          await deletePendingMutation(mutation.id);
        }
      }

      // Update sync metadata
      const metadata = await getSyncMetadata(entityType);
      if (metadata) {
        metadata.lastSyncTimestamp = result.serverTimestamp || Date.now();
        metadata.pendingChanges = Math.max(0, metadata.pendingChanges - mutations.length + conflicts.length);
        await updateSyncMetadata(metadata);
      }

      return { success: true, conflicts };
    } catch (error) {
      console.error('Sync push failed:', error);
      return { success: false, conflicts: [] };
    } finally {
      isSyncingRef.current = false;
    }
  }, [getPendingMutations, updateData, deletePendingMutation, getSyncMetadata, updateSyncMetadata, applyConflictResolution]);

  const syncPull = useCallback(async (entityType: string, apiBaseUrl: string): Promise<any[]> => {
    if (isSyncingRef.current) return [];
    isSyncingRef.current = true;

    try {
      const metadata = await getSyncMetadata(entityType);
      const since = metadata?.lastSyncTimestamp || 0;

      const response = await fetch(`${apiBaseUrl}/api/v1/sync/${entityType}/pull?since=${since}`, {
        credentials: 'include',
      });

      if (!response.ok) {
        throw new Error(`Sync pull failed: ${response.status}`);
      }

      const result = await response.json();
      const entities = result.entities || [];
      const serverTimestamp = result.serverTimestamp || Date.now();

      // Apply pulled entities to local storage
      for (const entity of entities) {
        const existing = await getData(entityType, entity.id);
        if (existing) {
          // Check for conflicts
          const strategy = ConflictResolutionStrategy.LAST_WRITE_WINS; // TODO: Get from config
          const resolvedData = applyConflictResolution(entity, existing.value, strategy);
          if (resolvedData !== null) {
            await updateData(entityType, entity.id, resolvedData);
          }
        } else {
          await saveData(entityType, entity.id, entity.value);
        }
      }

      // Update sync metadata
      if (metadata) {
        metadata.lastSyncTimestamp = serverTimestamp;
        metadata.pendingChanges = entities.length;
        await updateSyncMetadata(metadata);
      }

      return entities;
    } catch (error) {
      console.error('Sync pull failed:', error);
      return [];
    } finally {
      isSyncingRef.current = false;
    }
  }, [getSyncMetadata, getData, saveData, updateData, updateSyncMetadata, applyConflictResolution]);

  const syncAll = useCallback(async (entityTypes: string[], apiBaseUrl: string) => {
    const results = await Promise.all(
      entityTypes.map(type => Promise.all([
        syncPush(type, apiBaseUrl),
        syncPull(type, apiBaseUrl),
      ]))
    );
    return results;
  }, [syncPush, syncPull]);

  // Set up event listeners for online/offline events
  useEffect(() => {
    const handleOnline = async () => {
      console.log('Browser is online, syncing...');
      // Trigger sync for all entity types
      // In a real app, you'd get entity types from config
      const entityTypes = ['items', 'users', 'posts']; // TODO: Get from config
      await syncAll(entityTypes, process.env.NEXT_PUBLIC_API_URL || 'http://localhost:8000');
    };

    const handleOffline = () => {
      console.log('Browser is offline');
    };

    window.addEventListener('online', handleOnline);
    window.addEventListener('offline', handleOffline);

    return () => {
      window.removeEventListener('online', handleOnline);
      window.removeEventListener('offline', handleOffline);
    };
  }, [syncAll]);

  return {
    syncPush,
    syncPull,
    syncAll,
  };
}