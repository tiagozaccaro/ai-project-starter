import 'package:flutter/material.dart';
import 'package:go_router/go_router.dart';
{% if eq .AuthProvider "google-oidc" %}
import '../../services/auth_service.dart';
import 'package:url_launcher/url_launcher.dart';
{% end %}
{% if eq .AuthProvider "supabase" %}
import 'package:supabase_flutter/supabase_flutter.dart';
{% end %}

/// Authentication screen for the generated mobile app.
///
/// Mirrors the web login capability (platform parity,
/// Constitution IX). The provider matches the project's
/// exclusive auth selection (plan §5.1):
/// - google-oidc: FastAPI-managed OIDC flow
/// - supabase: Supabase Auth SDK
///
/// Replace the placeholder handlers with the real
/// provider integration for your auth provider.
class LoginScreen extends StatefulWidget {
  const LoginScreen({super.key});

  @override
  State<LoginScreen> createState() => _LoginScreenState();
}

class _LoginScreenState extends State<LoginScreen> {
  bool _isLoading = false;

  Future<void> _signIn() async {
    setState(() => _isLoading = true);
    try {
      {% if eq .AuthProvider "google-oidc" %}
      final baseUrl = const String.fromEnvironment('API_BASE_URL',
              defaultValue: 'http://10.0.2.2:8000');
      final uri = Uri.parse(
          '$baseUrl/api/v1/auth/google/login?redirect=${Uri.encodeComponent('/login')}&mobile=true');
      await launchUrl(uri, mode: LaunchMode.externalApplication);
      if (mounted) {
        context.go('/');
      }
      {% else if eq .AuthProvider "supabase" %}
      await Supabase.instance.client.auth.signInWithOAuth(
        OAuthProvider.google,
        redirectTo: 'com.example.app://login-callback',
      );
      {% else %}
      await Future<void>.delayed(const Duration(milliseconds: 300));
      if (mounted) {
        context.go('/');
      }
      {% end %}
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Failed to sign in: $e')),
        );
      }
    } finally {
      if (mounted) {
        setState(() => _isLoading = false);
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Sign in')),
      body: Center(
        child: Padding(
          padding: const EdgeInsets.all(24),
          child: FilledButton.icon(
            onPressed: _isLoading ? null : _signIn,
            icon: const Icon(Icons.login),
            label: Text(_isLoading ? 'Signing in...' : 'Continue with Google'),
          ),
        ),
      ),
    );
  }
}
