// Deep link handler for {% .ProjectName%}.
// Handles deep linking on mobile apps using go_router.
// When enabled on both web and mobile, provides consistent deep linking experience.

import 'package:flutter/material.dart';
import 'package:go_router/go_router.dart';
import 'package:shared_preferences/shared_preferences.dart';

class DeepLinkHandler {
  final GoRouter router;
  
  DeepLinkHandler({required this.router});
  
  // Initialize deep link handling
  Future<void> initialize() async {
    // Listen for app state changes (when app is already running)
    await _checkInitialUrl();
    
    // Listen for new links when app is backgrounded/terminated
    // In a real implementation, you would add event listeners here
    // for handling background URL handlers using app_links or uni_links
  }
  
  // Check for initial URL state
  Future<void> _checkInitialUrl() async {
    final prefs = await SharedPreferences.getInstance();
    final pendingUrl = prefs.getString('pending_deep_link');
    
    if (pendingUrl != null) {
      await prefs.remove('pending_deep_link');
      await _handleDeepLink(pendingUrl);
    }
  }
  
  // Handle deep link from external sources (web, other apps, notifications)
  Future<void> handleDeepLink(String url) async {
    // Parse the URL
    final uri = Uri.parse(url);
    final path = uri.path;
    
    if (path.isEmpty) {
      // Home route
      router.go('/');
      return;
    }
    
    // Extract path segments
    final segments = path.split('/').where((s) => s.isNotEmpty).toList();
    
    // Handle the deep link
    await _processSegments(segments, uri.queryParameters);
  }
  
  Future<void> _processSegments(List<String> segments, Map<String, String> queryParams) async {
    if (segments.isEmpty) {
      router.go('/');
      return;
    }
    
    final firstSegment = segments.first;
    
    switch (firstSegment) {
      case 'dashboard':
        if (segments.length > 1) {
          // Dashboard with specific item
          final id = segments[1];
          router.go('/dashboard/$id');
        } else {
          router.go('/dashboard');
        }
        break;
      case 'profile':
        if (segments.length > 1) {
          final userId = segments[1];
          router.go('/profile/$userId');
        } else {
          router.go('/profile');
        }
        break;
      case 'settings':
        router.go('/settings');
        break;
      case 'item':
      case 'items':
        if (segments.length > 1) {
          router.go('/items/${segments[1]}');
        }
        break;
      case 'login':
        router.go('/login');
        break;
      case 'register':
        router.go('/register');
        break;
      default:
        // Unrecognized deep link, navigate to error page or home
        router.go('/error?message=Deep link not recognized');
    }
  }
  
  // Store a pending deep link to handle when app launches
  Future<void> storePendingDeepLink(String url) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString('pending_deep_link', url);
  }
  
  // Clear any pending deep link
  Future<void> clearPendingDeepLink() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.remove('pending_deep_link');
  }
  
  // Navigate to deep link immediately (if app is active)
  void navigateTo(String url) {
    // Check if the URL is from the same app (custom URL scheme)
    const scheme = 'myapp'; // Would come from config
    if (url.startsWith('$scheme://')) {
      handleDeepLink(url.replaceFirst('$scheme://', ''));
    } else if (url.startsWith('https://')) {
      // Handle universal links
      handleDeepLink(url);
    }
  }
}

// Provider for the deep link handler
final deepLinkHandlerProvider = Provider<DeepLinkHandler>((ref) {
  final router = ref.watch(routerProvider);
  return DeepLinkHandler(router: router);
});

// Extension for easy access
extension DeepLinkHandlerExtensions on WidgetRef {
  DeepLinkHandler get deepLinkHandler => watch(deepLinkHandlerProvider);
  
  Future<void> handleDeepLink(String url) async {
    await deepLinkHandler.handleDeepLink(url);
  }
  
  Future<void> initializeDeepLinks() async {
    await deepLinkHandler.initialize();
  }
}