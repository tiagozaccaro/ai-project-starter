# Docker Compose for {% .ProjectName%}
# Two networks: frontend (web + nginx) and backend (api + db).
# External ports are mapped only for the web frontend;
# api and db are internal-only (research.md §14).

services:
{% if .GenerateWeb%}
  web:
    build:
      context: .
      dockerfile: Dockerfile.web
    networks:
      - frontend
    depends_on:
      - api
{% end%}
{% if .GenerateAPI%}
  api:
    build:
      context: .
      dockerfile: Dockerfile.api
    networks:
      - backend
    environment:
      DATABASE_URL: {% if eq .Database.Type "postgresql" %}postgresql+asyncpg://user:password@db:5432/{% .ProjectName %}{% else if eq .Database.Type "sqlite" %}sqlite+aiosqlite:///./app.db{% else if eq .Database.Type "mysql" %}mysql+aiomysql://user:password@db:3306/{% .ProjectName %}{% else if eq .Database.Type "mongodb" %}mongodb://db:27017/{% .ProjectName %}{% else %}sqlite+aiosqlite:///:memory:{% end %}
    depends_on:
{% if eq .Database.Type "postgresql"%}
      - db
{% else if eq .Database.Type "mysql"%}
      - db
{% else if eq .Database.Type "mongodb"%}
      - db
{% end%}
{% end%}
{% if eq .Database.Type "postgresql"%}
  db:
    image: postgres:16-alpine
    networks:
      - backend
    environment:
      POSTGRES_USER: user
      POSTGRES_PASSWORD: password
      POSTGRES_DB: {% .ProjectName%}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U user -d {% .ProjectName%}"]
      interval: 5s
      timeout: 5s
      retries: 5
{% else if eq .Database.Type "mysql"%}
  db:
    image: mysql:8
    networks:
      - backend
    environment:
      MYSQL_USER: user
      MYSQL_PASSWORD: password
      MYSQL_DATABASE: {% .ProjectName%}
      MYSQL_ROOT_PASSWORD: rootpassword
    volumes:
      - mysqldata:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -u user -ppassword"]
      interval: 5s
      timeout: 5s
      retries: 5
{% else if eq .Database.Type "mongodb"%}
  db:
    image: mongo:7
    networks:
      - backend
    volumes:
      - mongodata:/data/db
    healthcheck:
      test: ["CMD-SHELL", "mongosh --eval 'db.runCommand({ping:1})'"]
      interval: 5s
      timeout: 5s
      retries: 5
{% end%}
{% if .GenerateWeb%}
  nginx:
    image: nginx:alpine
    networks:
      - frontend
    ports:
      - "80:80"
    depends_on:
      - web
    volumes:
      - ./docker/nginx.conf:/etc/nginx/nginx.conf:ro
{% end%}

networks:
  frontend:
  backend:

volumes:
{% if eq .Database.Type "postgresql"%}
  pgdata:
{% else if eq .Database.Type "mysql"%}
  mysqldata:
{% else if eq .Database.Type "mongodb"%}
  mongodata:
{% end%}
