"""Task queue configuration for {% .ProjectName%}.

Uses Celery with a Redis broker.
"""

import os

from celery import Celery

redis_url = os.getenv("REDIS_URL", "redis://localhost:6379/0")

celery_app = Celery(
    "{% .ProjectName%}",
    broker=redis_url,
    backend=redis_url,
    include=["app.worker"],
)

celery_app.conf.update(
    task_serializer="json",
    accept_content=["json"],
    result_serializer="json",
    timezone="UTC",
    enable_utc=True,
)
