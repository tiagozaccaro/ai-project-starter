"""Background worker for {% .ProjectName%}.

Processes queued tasks via Celery/Redis.
"""

import logging

from app.queue import celery_app

logger = logging.getLogger(__name__)


@celery_app.task(name="process_task")
def process_task(payload: dict) -> dict:
    """Process a queued task."""
    logger.info("Processing task: %s", payload)
    return {"status": "processed", "payload": payload}


@celery_app.task(name="send_notification")
def send_notification(recipient: str, message: str) -> dict:
    """Send a notification to a recipient."""
    logger.info("Sending notification to %s", recipient)
    return {"status": "sent", "recipient": recipient}
