name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

jobs:
{% if .GenerateWeb%}
  web:
    name: Web (Next.js)
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [macos-latest, ubuntu-latest]
        node-version: [20]
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 9
      - uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node-version }}
          cache: pnpm
          cache-dependency-path: {% .WebDir%}/pnpm-lock.yaml
      - name: Install
        working-directory: {% .WebDir%}
        run: pnpm install --frozen-lockfile
      - name: Lint
        working-directory: {% .WebDir%}
        run: pnpm lint
      - name: Typecheck
        working-directory: {% .WebDir%}
        run: pnpm typecheck
      - name: Test
        working-directory: {% .WebDir%}
        run: pnpm test
      - name: Build
        working-directory: {% .WebDir%}
        run: pnpm build
{% end%}{% if .GenerateAPI%}
  api:
    name: API (FastAPI)
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [macos-latest, ubuntu-latest]
        python-version: ["3.11", "3.12"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: Install uv
        uses: astral-sh/setup-uv@v3
        with:
          enable-cache: true
          cache-dependency-glob: {% .APIDir%}/uv.lock
      - name: Sync
        working-directory: {% .APIDir%}
        run: uv sync --frozen
      - name: Lint
        working-directory: {% .APIDir%}
        run: uv run ruff check
      - name: Typecheck
        working-directory: {% .APIDir%}
        run: uv run pyright
      - name: Test
        working-directory: {% .APIDir%}
        run: uv run pytest --cov --cov-fail-under=80
{% end%}{% if .GenerateMobile%}
  mobile:
    name: Mobile (Flutter)
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - uses: subosito/flutter-action@v2
        with:
          flutter-version: "3.19.x"
          cache: true
      - name: Pub get
        working-directory: {% .MobileDir%}
        run: flutter pub get --offline
      - name: Analyze
        working-directory: {% .MobileDir%}
        run: flutter analyze
      - name: Test
        working-directory: {% .MobileDir%}
        run: flutter test
{% end%}{% if .GenerateDocker%}
  docker:
    name: Docker Compose
    runs-on: ubuntu-latest
    needs: {% if and .GenerateWeb .GenerateAPI%}["web", "api"]{% else if .GenerateWeb%}["web"]{% else%}["api"]{% end%}
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-buildx-action@v3
      - name: Build
        run: docker compose build
      - name: Up
        run: docker compose up -d
      - name: Wait
        run: sleep 15
      - name: Health check
        run: |
          curl -f http://localhost:8000/api/v1/health
          curl -f http://localhost/
      - name: Down
        if: always()
        run: docker compose down
{% end%}
