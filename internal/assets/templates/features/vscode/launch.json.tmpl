{
  "version": "0.2.0",
  "configurations": [
{% if .GenerateWeb%}
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug Web (Next.js)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/{% .WebDir%}",
      "sourceMaps": true
    },
{% end%}{% if .GenerateAPI%}
    {
      "name": "Debug API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/{% .APIDir%}",
      "env": { "PYTHONPATH": "${workspaceFolder}/{% .APIDir%}" },
      "justMyCode": false
    },
{% end%}{% if and .GenerateWeb .GenerateAPI%}
    {
      "name": "Debug Fullstack",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Start Fullstack",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    }
{% end%}
  ]
}
