{
  "version": "2.0.0",
  "tasks": [
{% if .GenerateWeb%}
    {
      "label": "Install Web",
      "type": "shell",
      "command": "pnpm install",
      "options": { "cwd": "${workspaceFolder}/{% .WebDir%}" },
      "group": "build"
    },
    {
      "label": "Build Web",
      "type": "shell",
      "command": "pnpm run build",
      "options": { "cwd": "${workspaceFolder}/{% .WebDir%}" },
      "group": "build"
    },
{% end%}{% if .GenerateAPI%}
    {
      "label": "Sync API",
      "type": "shell",
      "command": "uv sync",
      "options": { "cwd": "${workspaceFolder}/{% .APIDir%}" },
      "group": "build"
    },
    {
      "label": "Test API",
      "type": "shell",
      "command": "uv run pytest",
      "options": { "cwd": "${workspaceFolder}/{% .APIDir%}" },
      "group": "test"
    },
{% end%}{% if and .GenerateWeb .GenerateAPI%}
    {
      "label": "Start Fullstack",
      "dependsOrder": "parallel",
      "dependsOn": ["Start Web", "Start API"],
      "group": "build"
    },
    {
      "label": "Start Web",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}/{% .WebDir%}" }
    },
    {
      "label": "Start API",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}/{% .APIDir%}" }
    }
{% end%}
  ]
}
