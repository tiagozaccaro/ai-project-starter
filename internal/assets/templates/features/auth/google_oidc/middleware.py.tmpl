"""Authentication middleware for {% .ProjectName%}.

Validates the HTTP-only session cookie on protected
routes and exposes the authenticated user identity.
"""

from starlette.middleware.base import BaseHTTPMiddleware
from starlette.requests import Request
from starlette.responses import RedirectResponse

from app.core.security import verify_session_token


class AuthMiddleware(BaseHTTPMiddleware):
    """Require a valid session on protected API routes."""

    def __init__(self, app, protected_prefixes=("/api/v1",)):
        super().__init__(app)
        self.protected_prefixes = protected_prefixes

    async def dispatch(self, request: Request, call_next):
        path = request.url.path

        is_protected = any(
            path.startswith(prefix) for prefix in self.protected_prefixes
        )
        if not is_protected:
            return await call_next(request)

        # Public endpoints that live under protected prefixes.
        if path in ("/api/v1/health", "/api/v1/auth/login", "/api/v1/auth/callback"):
            return await call_next(request)

        session_token = request.cookies.get("session")
        if session_token is None:
            return RedirectResponse("/login", status_code=401)

        claims = verify_session_token(session_token)
        if claims is None:
            return RedirectResponse("/login", status_code=401)

        request.state.user = claims
        return await call_next(request)
