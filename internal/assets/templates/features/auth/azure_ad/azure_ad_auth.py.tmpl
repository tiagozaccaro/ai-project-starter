"""Azure AD authentication for {% .ProjectName%}.
Handles authentication with Azure Active Directory using OpenID Connect.
"""

import json
import requests
from datetime import datetime, timedelta
from typing import Dict, Optional
from fastapi import HTTPException, status
from jose import jwt
from jose.exceptions import JWTClaimsError, JWTError

from ..base import BaseAuthProvider
from ..utils import verify_jwt_token


class AzureAuthProvider(BaseAuthProvider):
    """Azure Active Directory authentication provider."""
    
    def __init__(self, tenant_id: str, client_id: str):
        super().__init__()
        self.tenant_id = tenant_id
        self.client_id = client_id
        self.authority = f"https://login.microsoftonline.com/{tenant_id}/v2.0"
        self.jwks_url = f"{self.authority}/discovery/v2.0/keys"
        self.audience = f"api://{client_id}"
        self.issuer = f"{self.authority}/"
    
    async def validate_id_token(self, id_token: str) -> Dict:
        """Validate Azure AD ID token and extract user information."""
        try:
            # Get Microsoft's public keys
            jwks_response = requests.get(self.jwks_url)
            jwks_response.raise_for_status()
            jwks = jwks_response.json()
            
            # Decode the token header to get the key ID
            header = jwt.get_unverified_header(id_token)
            kid = header.get('kid')
            
            # Find the matching key
            key = None
            for jwk_dict in jwks['keys']:
                if jwk_dict.get('kid') == kid:
                    key = jwk_dict
                    break
            
            if not key:
                raise HTTPException(
                    status_code=status.HTTP_401_UNAUTHORIZED,
                    detail="Unable to find appropriate key"
                )
            
            # Verify the token
            try:
                claims = jwt.decode(
                    id_token,
                    key,
                    algorithms=['RS256'],
                    audience=self.audience,
                    issuer=self.issuer
                )
            except JWTClaimsError as e:
                raise HTTPException(
                    status_code=status.HTTP_401_UNAUTHORIZED,
                    detail=f"Token claims validation failed: {str(e)}"
                )
            except JWTError as e:
                raise HTTPException(
                    status_code=status.HTTP_401_UNAUTHORIZED,
                    detail=f"Token validation failed: {str(e)}"
                )
            
            # Extract user information
            user_info = {
                'azure_id': claims.get('oid'),
                'email': claims.get('email') or claims.get('upn'),
                'email_verified': claims.get('email_verified', False),
                'name': claims.get('name'),
                'given_name': claims.get('given_name'),
                'family_name': claims.get('family_name'),
                'preferred_username': claims.get('preferred_username'),
                'tenant_id': claims.get('tid'),
                'roles': claims.get('roles', []),
                'groups': claims.get('groups', [])
            }
            
            return user_info
            
        except Exception as e:
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail=f"Azure AD token validation failed: {str(e)}"
            )
    
    async def authenticate(self, credentials: Dict) -> Dict:
        """Authenticate user with Azure AD credentials."""
        # Support both authorization code flow and implicit flow
        id_token = credentials.get('id_token')
        access_token = credentials.get('access_token')
        
        if not id_token:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Missing id_token"
            )
        
        # Validate the ID token
        user_info = await self.validate_id_token(id_token)
        
        # If we have an access token, we could also validate it and get more info
        # For now, we'll just use the ID token
        
        return {
            'provider': 'azure_ad',
            'provider_user_id': user_info['azure_id'],
            'email': user_info['email'],
            'email_verified': user_info['email_verified'],
            'name': user_info['name'],
            'raw_info': user_info
        }
