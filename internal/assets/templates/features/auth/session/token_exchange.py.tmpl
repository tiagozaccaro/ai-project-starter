"""Token exchange endpoint for {% .ProjectName%}.
Handles OAuth code exchange and session token creation for cross-platform auth.
"""

from fastapi import APIRouter, Request, HTTPException
from pydantic import BaseModel
from typing import Optional
import httpx

from app.core.config import get_settings
from app.core.security import verify_id_token, create_session_token

router = APIRouter(prefix="/auth", tags=["auth"])


class ExchangeRequest(BaseModel):
    code: str
    redirect_uri: str
    provider: str = "google"  # google or supabase


class ExchangeResponse(BaseModel):
    access_token: str
    refresh_token: Optional[str] = None
    expires_in: int
    token_type: str
    user: dict
    session_token: str


@router.post("/exchange", response_model=ExchangeResponse)
async def exchange_code(request: ExchangeRequest, response: Response):
    """Convert OAuth authorization code to tokens for cross-platform use."""
    settings = get_settings()
    
    if request.provider == "google":
        # Exchange Google OAuth code for tokens
        async with httpx.AsyncClient() as client:
            token_response = await client.post(
                "https://oauth2.googleapis.com/token",
                data={
                    "code": request.code,
                    "client_id": settings.google_client_id,
                    "client_secret": settings.google_client_secret,
                    "redirect_uri": request.redirect_uri,
                    "grant_type": "authorization_code",
                },
            )

            if token_response.status_code != 200:
                raise HTTPException(status_code=400, detail="Failed to exchange code")

            tokens = token_response.json()

        id_token = tokens.get("id_token", "")
        claims = verify_id_token(id_token, settings.google_client_id)
        if not claims:
            raise HTTPException(status_code=400, detail="Invalid ID token")

        session_token = create_session_token(claims)

        # Set session cookie for web
        response.set_cookie(
            key="session",
            value=session_token,
            httponly=True,
            secure=settings.environment == "production",
            samesite="lax",
            max_age=tokens.get("expires_in", 3600),
        )

        return ExchangeResponse(
            access_token=tokens.get("access_token"),
            refresh_token=tokens.get("refresh_token"),
            expires_in=tokens.get("expires_in", 3600),
            token_type=tokens.get("token_type", "Bearer"),
            user={
                "id": claims.get("sub"),
                "email": claims.get("email"),
                "name": claims.get("name"),
                "picture": claims.get("picture"),
            },
            session_token=session_token,
        )
    
    elif request.provider == "supabase":
        # Exchange Supabase auth code for session
        # This would use Supabase's exchange_code_for_session
        raise HTTPException(status_code=501, detail="Supabase exchange not yet implemented")
    
    else:
        raise HTTPException(status_code=400, detail="Unsupported provider")


@router.post("/refresh")
async def refresh_token(request: Request, response: Response):
    """Refresh access token using refresh token."""
    settings = get_settings()
    
    refresh_token = request.cookies.get("refresh_token")
    if not refresh_token:
        raise HTTPException(status_code=401, detail="No refresh token")

    # Implementation depends on auth provider
    # For Google: use refresh_token to get new access_token
    # For Supabase: use refresh_token to get new session
    
    return {"message": "Token refresh not yet implemented"}


@router.post("/logout")
async def logout(request: Request, response: Response):
    """Clear session tokens."""
    response.delete_cookie("session")
    response.delete_cookie("refresh_token")
    return {"message": "Logged out successfully"}