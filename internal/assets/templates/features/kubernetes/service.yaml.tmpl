apiVersion: v1
kind: Service
metadata:
  name: {% .ProjectName%}-api
  labels:
    app: {% .ProjectName%}-api
spec:
  type: {% .ServiceType | default "ClusterIP" %}
  ports:
  - port: 80
    targetPort: 8000
    protocol: TCP
    name: http
  selector:
    app: {% .ProjectName%}-api
---
apiVersion: v1
kind: Service
metadata:
  name: {% .ProjectName%}-api-headless
  labels:
    app: {% .ProjectName%}-api
spec:
  type: ClusterIP
  clusterIP: None
  ports:
  - port: 8000
    name: http
  selector:
    app: {% .ProjectName%}-api
