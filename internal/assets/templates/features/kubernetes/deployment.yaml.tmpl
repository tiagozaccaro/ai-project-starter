apiVersion: apps/v1
kind: Deployment
metadata:
  name: {% .ProjectName%}-api
  labels:
    app: {% .ProjectName%}-api
spec:
  replicas: {% .Replicas | default 3 %}
  selector:
    matchLabels:
      app: {% .ProjectName%}-api
  template:
    metadata:
      labels:
        app: {% .ProjectName%}-api
    spec:
      containers:
      - name: api
        image: {% .ImageName%}:{% .ImageTag%}
        ports:
        - containerPort: 8000
        env:
        - name: ENVIRONMENT
          value: "{% .Environment %}"
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef:
              name: {% .ProjectName%}-secrets
              key: database-url
        - name: REDIS_URL
          valueFrom:
            secretKeyRef:
              name: {% .ProjectName%}-secrets
              key: redis-url
        - name: JWT_SECRET_KEY
          valueFrom:
            secretKeyRef:
              name: {% .ProjectName%}-secrets
              key: jwt-secret-key
        resources:
          requests:
            memory: "256Mi"
            cpu: "250m"
          limits:
            memory: "512Mi"
            cpu: "500m"
        lifecycle:
          preStop:
            exec:
              command: ["/bin/sh", "-c", "sleep 10"]
      - name: migrations
        image: {% .ImageName%}:{% .ImageTag%}
        command: ["sh", "-c", "alembic upgrade head"]
        env:
        - name: ENVIRONMENT
          value: "{% .Environment %}"
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef:
              name: {% .ProjectName%}-secrets
              key: database-url
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "256Mi"
            cpu: "200m"
        restartPolicy: OnFailure
