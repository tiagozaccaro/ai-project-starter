function handleAction(action: string, data: any): void {
  switch (action) {
    case 'view':
      // Navigate to the content
      if (clients.openWindow && data.url) {
        clients.openWindow(data.url);
      }
      break;
    case 'dismiss':
      // Just close the notification (already closed by event.notification.close())
      break;
    case 'snooze':
      // Reschedule notification
      if (data.snoozeMinutes) {
        scheduleSnooze(data, data.snoozeMinutes);
      }
      break;
    default:
      console.log('Unknown action:', action);
  }
}

function scheduleSnooze(data: any, minutes: number): void {
  setTimeout(() => {
    self.registration.showNotification(data.title || '{% .ProjectName %}', {
      body: data.body || 'Snoozed notification',
      icon: data.icon || '/icon-192.png',
      data: { ...data, snoozed: true },
      tag: `${data.tag}-snoozed`,
    });
  }, minutes * 60 * 1000);
}

// Message event - communicate with main thread
self.addEventListener('message', (event: ExtendableMessageEvent) => {
  if (event.data?.type === 'SKIP_WAITING') {
    (self as any).skipWaiting();
  }
  
  if (event.data?.type === 'GET_VERSION') {
    event.ports[0].postMessage({ version: CACHE_NAME });
  }
});

