"""FCM topic management endpoints for {% .ProjectName%}.
Handles subscribing and unsubscribing from FCM topics.
"""

from fastapi import APIRouter, HTTPException, Depends
from typing import List
from app.core.config import get_settings
from sqlalchemy.orm import Session
from app.database import get_db
from app.models import FcmToken

router = APIRouter(prefix="/push/topics", tags=["topics"])


@router.post("/subscribe")
async def subscribe_to_topic(
    request: Dict[str, str],
    db: Session = Depends(get_db)
):
    """Subscribe a device to an FCM topic."""
    settings = get_settings()
    if not settings.fcm_server_key:
        raise HTTPException(status_code=503, detail="FCM not configured")
    
    token = request.get("token")
    topic = request.get("topic")
    
    if not token or not topic:
        raise HTTPException(status_code=400, detail="Token and topic are required")
    
    # In a full implementation, we would use the FCM admin SDK to manage topics
    # For now, we'll store the topic association in our database
    fcm_token = db.query(FcmToken).filter(FcmToken.token == token).first()
    if fcm_token:
        # In a real app, we'd have a many-to-many relationship between tokens and topics
        # For simplicity, we'll just note that this endpoint exists
        pass
    
    return {"status": "subscribed", "token": token, "topic": topic}


@router.post("/unsubscribe")
async def unsubscribe_from_topic(
    request: Dict[str, str],
    db: Session = Depends(get_db)
):
    """Unsubscribe a device from an FCM topic."""
    settings = get_settings()
    if not settings.fcm_server_key:
        raise HTTPException(status_code=503, detail="FCM not configured")
    
    token = request.get("token")
    topic = request.get("topic")
    
    if not token or not topic:
        raise HTTPException(status_code=400, detail="Token and topic are required")
    
    # In a full implementation, we would use the FCM admin SDK to manage topics
    fcm_token = db.query(FcmToken).filter(FcmToken.token == token).first()
    if fcm_token:
        # In a real app, we'd remove the topic association
        pass
    
    return {"status": "unsubscribed", "token": token, "topic": topic}