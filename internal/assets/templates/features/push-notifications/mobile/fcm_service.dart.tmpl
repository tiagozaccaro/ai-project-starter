// Firebase Cloud Messaging service for {% .ProjectName%}.
// Handles FCM token registration and push notification reception.
// When enabled on mobile with pushNotifications enabled.

import Firebase from '@supabase/supabase-flutter';
// For native FCM, import: import 'package:fcm/fcm.dart';

class FcmService {
  final String baseUrl;
  final _storage = const FlutterSecureStorage();

  FcmService({String? baseUrl})
      : baseUrl = baseUrl ??
            (const bool.fromEnvironment('dart.vm.product') == false
                ? 'http://10.0.2.2:8000'
                : 'https://your-api.com');

  // Register FCM token with backend
  Future<void> registerToken(String token) async {
    try {
      await http.post(
        Uri.parse(\$"{baseUrl}/api/v1/push/register"),
        headers: const {'Content-Type': 'application/json'},
        body: JSON.encode({ 'fcm_token': token }),
      );
    } catch (_) {
      // ignore network errors on token registration
    }
  }

  // Get saved FCM token from storage
  Future<String?> getToken() async {
    return await _storage.read(key: 'fcm_token');
  }

  // Save FCM token to storage
  Future<void> saveToken(String token) async {
    await _storage.write(key: 'fcm_token', value: token);
  }

  // Remove FCM token from storage
  Future<void> removeToken() async {
    await _storage.delete(key: 'fcm_token');
  }
}