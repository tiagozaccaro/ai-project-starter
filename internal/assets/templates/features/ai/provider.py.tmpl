"""AI provider abstraction using Pydantic AI for {% .ProjectName%}.

Uses pydantic-ai for type-safe agent orchestration with OpenAI-compatible APIs.
"""

from pydantic_ai import Agent
from pydantic_ai.models.openai import OpenAIModel
from pydantic_ai.providers.openai import OpenAIProvider as PydanticOpenAIProvider
from pydantic import BaseModel, Field

from app.core.config import get_settings


class CompletionRequest(BaseModel):
    """A text completion request."""

    prompt: str = Field(..., min_length=1)
    model: str = "gpt-4o-mini"
    max_tokens: int = 256
    temperature: float = 0.7


class CompletionResponse(BaseModel):
    """A text completion response."""

    text: str
    model: str
    provider: str


async def get_openai_model(model: str = "gpt-4o-mini") -> OpenAIModel:
    """Create an OpenAI-compatible model for Pydantic AI."""
    settings = get_settings()
    provider = PydanticOpenAIProvider(
        api_key=settings.openai_api_key,
        base_url=getattr(settings, "openai_base_url", None),
    )
    return OpenAIModel(model, provider=provider)


async def complete(request: CompletionRequest) -> CompletionResponse:
    """Generate a completion using Pydantic AI."""
    model = await get_openai_model(request.model)
    agent = Agent(model)

    result = await agent.run(request.prompt)
    return CompletionResponse(
        text=result.data,
        model=request.model,
        provider="openai",
    )


async def stream_complete(request: CompletionRequest):
    """Stream a completion using Pydantic AI."""
    model = await get_openai_model(request.model)
    agent = Agent(model)

    async with agent.run_stream(request.prompt) as result:
        async for chunk in result.stream_text(delta=True):
            yield chunk


def create_agent(
    system_prompt: str,
    model: str = "gpt-4o-mini",
    output_type: type[BaseModel] | None = None,
    tools: list = None,
) -> Agent:
    """Create a typed Pydantic AI agent.

    Args:
        system_prompt: System instructions for the agent
        model: Model name (OpenAI-compatible)
        output_type: Pydantic model for structured output
        tools: List of tool functions (async functions with Pydantic models)

    Returns:
        Configured Pydantic AI Agent
    """
    return Agent(
        await get_openai_model(model),
        system_prompt=system_prompt,
        output_type=output_type,
        tools=tools or [],
    )