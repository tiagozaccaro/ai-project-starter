"""AI Agent framework for {% .ProjectName%}.

Provides a lightweight agent abstraction supporting:
- Autonomous agents (run without user interaction)
- Interactive agents (chat-based with user interaction)
- Tool/function calling
- Streaming responses
- Multi-step reasoning

Uses OpenAI-compatible APIs so any compatible provider works.
"""

from abc import ABC, abstractmethod
from dataclasses import dataclass, field
from typing import Any, AsyncIterator, Callable, Optional
from enum import Enum
import json
import uuid


class AgentType(str, Enum):
    """Agent execution mode."""

    AUTONOMOUS = "autonomous"  # Runs without user interaction
    INTERACTIVE = "interactive"  # Chat-based with user interaction


@dataclass
class Tool:
    """A tool/function that agents can call."""

    name: str
    description: str
    parameters: dict[str, Any]  # JSON Schema
    function: Callable[..., Any]


@dataclass
class ToolCall:
    """A tool call made by the agent."""

    id: str
    name: str
    arguments: dict[str, Any]


@dataclass
class ToolResult:
    """Result of a tool execution."""

    tool_call_id: str
    name: str
    content: str
    error: Optional[str] = None


@dataclass
class AgentMessage:
    """A message in the agent conversation."""

    role: str  # "system", "user", "assistant", "tool"
    content: Optional[str] = None
    tool_calls: list[ToolCall] = field(default_factory=list)
    tool_call_id: Optional[str] = None
    name: Optional[str] = None  # for tool messages


@dataclass
class AgentConfig:
    """Configuration for an agent."""

    name: str
    description: str
    system_prompt: str
    model: str = "gpt-4o-mini"
    temperature: float = 0.7
    max_tokens: int = 4096
    tools: list[Tool] = field(default_factory=list)
    agent_type: AgentType = AgentType.INTERACTIVE
    max_iterations: int = 10  # For autonomous agents


class Agent(ABC):
    """Base agent class."""

    def __init__(self, config: AgentConfig):
        self.config = config
        self.conversation: list[AgentMessage] = []
        self._add_system_message(config.system_prompt)

    def _add_system_message(self, content: str) -> None:
        self.conversation.append(AgentMessage(role="system", content=content))

    def add_user_message(self, content: str) -> None:
        self.conversation.append(AgentMessage(role="user", content=content))

    def add_assistant_message(self, content: str, tool_calls: list[ToolCall] = None) -> None:
        self.conversation.append(AgentMessage(role="assistant", content=content, tool_calls=tool_calls or []))

    def add_tool_result(self, tool_call_id: str, name: str, content: str, error: str = None) -> None:
        self.conversation.append(AgentMessage(role="tool", content=content, tool_call_id=tool_call_id, name=name))

    @abstractmethod
    async def run(self, user_input: str = "") -> AsyncIterator[str]:
        """Run the agent and yield response chunks."""

    @abstractmethod
    async def run_autonomous(self, task: str) -> str:
        """Run autonomous agent to completion."""

    def get_conversation(self) -> list[AgentMessage]:
        return self.conversation

    def clear_conversation(self) -> None:
        self.conversation = []
        self._add_system_message(self.config.system_prompt)


class OpenAICompatibleAgent(Agent):
    """Agent using OpenAI-compatible API with function calling support."""

    def __init__(self, config: AgentConfig, api_key: str, base_url: Optional[str] = None):
        super().__init__(config)
        self.api_key = api_key
        self.base_url = base_url
        self._client = None

    @property
    def client(self):
        if self._client is None:
            from openai import AsyncOpenAI
            self._client = AsyncOpenAI(api_key=self.api_key, base_url=self.base_url)
        return self._client

    def _build_tools_schema(self) -> list[dict]:
        """Convert tools to OpenAI function calling schema."""
        return [
            {
                "type": "function",
                "function": {
                    "name": tool.name,
                    "description": tool.description,
                    "parameters": tool.parameters,
                },
            }
            for tool in self.config.tools
        ]

    def _build_messages(self) -> list[dict]:
        """Convert conversation to OpenAI message format."""
        messages = []
        for msg in self.conversation:
            if msg.role == "tool":
                messages.append({
                    "role": "tool",
                    "tool_call_id": msg.tool_call_id,
                    "content": msg.content,
                })
            elif msg.tool_calls:
                messages.append({
                    "role": "assistant",
                    "content": msg.content,
                    "tool_calls": [
                        {
                            "id": tc.id,
                            "type": "function",
                            "function": {"name": tc.name, "arguments": json.dumps(tc.arguments)},
                        }
                        for tc in msg.tool_calls
                    ],
                })
            else:
                messages.append({"role": msg.role, "content": msg.content or ""})
        return messages

    async def run(self, user_input: str = "") -> AsyncIterator[str]:
        """Run interactive agent with streaming."""
        if user_input:
            self.add_user_message(user_input)

        tools_schema = self._build_tools_schema() if self.config.tools else None
        messages = self._build_messages()

        stream = await self.client.chat.completions.create(
            model=self.config.model,
            messages=messages,
            tools=tools_schema or None,
            tool_choice="auto" if tools_schema else None,
            temperature=self.config.temperature,
            max_tokens=self.config.max_tokens,
            stream=True,
        )

        full_content = ""
        tool_calls: list[ToolCall] = []

        async for chunk in stream:
            delta = chunk.choices[0].delta
            if delta.content:
                full_content += delta.content
                yield delta.content
            if delta.tool_calls:
                for tc in delta.tool_calls:
                    if tc.index >= len(tool_calls):
                        tool_calls.append(ToolCall(id=tc.id, name=tc.function.name, arguments={}))
                    if tc.function.arguments:
                        tool_calls[tc.index].arguments.update(json.loads(tc.function.arguments))

        # Execute tool calls if any
        if tool_calls:
            self.add_assistant_message(full_content, tool_calls)
            for tool_call in tool_calls:
                tool = next((t for t in self.config.tools if t.name == tool_call.name), None)
                if tool:
                    try:
                        result = await tool.function(**tool_call.arguments)
                        result_str = json.dumps(result) if not isinstance(result, str) else result
                        self.add_tool_result(tool_call.id, tool_call.name, result_str)
                    except Exception as e:
                        self.add_tool_result(tool_call.id, tool_call.name, "", error=str(e))

            # Recursively continue after tool execution
            async for chunk in self.run(""):
                yield chunk
        else:
            self.add_assistant_message(full_content)

    async def run_autonomous(self, task: str) -> str:
        """Run autonomous agent to completion."""
        self.add_user_message(task)
        full_response = ""
        iteration = 0

        while iteration < self.config.max_iterations:
            iteration += 1
            tools_schema = self._build_tools_schema() if self.config.tools else None
            messages = self._build_messages()

            response = await self.client.chat.completions.create(
                model=self.config.model,
                messages=messages,
                tools=tools_schema or None,
                tool_choice="auto" if tools_schema else None,
                temperature=self.config.temperature,
                max_tokens=self.config.max_tokens,
            )

            message = response.choices[0].message
            if message.content:
                full_response += message.content + "\n"

            if message.tool_calls:
                self.add_assistant_message(message.content or "", [
                    ToolCall(id=tc.id, name=tc.function.name, arguments=json.loads(tc.function.arguments))
                    for tc in message.tool_calls
                ])
                for tool_call in message.tool_calls:
                    tool = next((t for t in self.config.tools if t.name == tool_call.function.name), None)
                    if tool:
                        try:
                            result = await tool.function(**json.loads(tool_call.function.arguments))
                            result_str = json.dumps(result) if not isinstance(result, str) else result
                            self.add_tool_result(tool_call.id, tool_call.function.name, result_str)
                        except Exception as e:
                            self.add_tool_result(tool_call.id, tool_call.function.name, "", error=str(e))
            else:
                self.add_assistant_message(message.content or "")
                break

        return full_response


# Pre-built agent templates
def create_code_agent(api_key: str, base_url: Optional[str] = None) -> OpenAICompatibleAgent:
    """Create a code generation agent."""
    from app.ai.tools import get_code_tools
    config = AgentConfig(
        name="CodeAgent",
        description="Generates and modifies code",
        system_prompt="You are an expert software engineer. Write clean, tested, production-ready code.",
        model="gpt-4o",
        tools=get_code_tools(),
        agent_type=AgentType.AUTONOMOUS,
    )
    return OpenAICompatibleAgent(config, api_key, base_url)


def create_research_agent(api_key: str, base_url: Optional[str] = None) -> OpenAICompatibleAgent:
