def create_chat_agent(api_key: str, base_url: Optional[str] = None) -> OpenAICompatibleAgent:
    """Create a general-purpose chat agent."""
    config = AgentConfig(
        name="ChatAgent",
        description="General purpose conversational agent",
        system_prompt="You are a helpful assistant. Be concise and accurate.",
        model="gpt-4o-mini",
        agent_type=AgentType.INTERACTIVE,
    )
    return OpenAICompatibleAgent(config, api_key, base_url)