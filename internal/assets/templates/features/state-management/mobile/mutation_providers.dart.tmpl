// Mutation providers for {% .ProjectName%}.
// Handles create, update, delete operations with optimistic updates.

import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'riverpod_provider.dart';

// Generic mutation provider
final createMutationProvider = FutureProvider.family<dynamic, ({String endpoint, Map<String, dynamic> body})>((ref, params) async {
  final baseUrl = ref.watch(apiBaseUrlProvider);
  final client = ref.watch(httpClientProvider);
  
  final response = await client.post(
    Uri.parse('$baseUrl${params.endpoint}'),
    headers: {'Content-Type': 'application/json'},
    body: jsonEncode(params.body),
  );
  
  if (response.statusCode < 200 || response.statusCode >= 300) {
    throw Exception('Create failed: ${response.statusCode}');
  }
  
  return jsonDecode(response.body);
});

final updateMutationProvider = FutureProvider.family<dynamic, ({String endpoint, String id, Map<String, dynamic> body})>((ref, params) async {
  final baseUrl = ref.watch(apiBaseUrlProvider);
