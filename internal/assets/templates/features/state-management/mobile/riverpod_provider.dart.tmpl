// Query invalidation helper
class QueryInvalidator {
  final Ref ref;
  
  QueryInvalidator(this.ref);
  
  void invalidateEndpoint(String endpoint) {
    ref.invalidate(queryProvider(endpoint));
  }
  
  void invalidateAll() {
    // Would invalidate all queries - in practice, track registered endpoints
    // ref.invalidate(queryProvider);
  }
}

final queryInvalidatorProvider = Provider<QueryInvalidator>((ref) {
  return QueryInvalidator(ref);
});