// Provider for query configuration
final queryConfigProvider = Provider<QueryConfig>((ref) {
  return const QueryConfig(
    staleTime: Duration(minutes: 1),
    cacheTime: Duration(minutes: 5),
    retry: 1,
    refetchOnResume: true,
  );
});

class QueryConfig {
  final Duration staleTime;
  final Duration cacheTime;
  final int retry;
  final bool refetchOnResume;
  
  const QueryConfig({
    required this.staleTime,
    required this.cacheTime,
    required this.retry,
    required this.refetchOnResume,
  });
}

// Extension methods for easier query usage
extension QueryProviderExtensions on WidgetRef {
  // Watch a list query
  AsyncValue<List<dynamic>> watchList(String endpoint) {
    return watch(listQueryProvider(endpoint));
  }
  
  // Watch a single item query
  AsyncValue<dynamic> watchItem(String endpoint, String id) {
    return watch(itemQueryProvider((endpoint: endpoint, id: id)));
  }
  
  // Watch a parameterized query
  AsyncValue<dynamic> watchParameterized(String endpoint, Map<String, String> params) {
    return watch(parameterizedQueryProvider((endpoint: endpoint, params: params)));
  }
  
  // Refresh a list query
  Future<void> refreshList(String endpoint) async {
    invalidate(listQueryProvider(endpoint));
  }
  
  // Refresh an item query
  Future<void> refreshItem(String endpoint, String id) async {
    invalidate(itemQueryProvider((endpoint: endpoint, id: id)));
  }
}