// Provider for optimistic state (to be customized per entity)
final optimisticStateProvider = StateNotifierProvider.family<StateNotifier<AsyncValue<OptimisticState<dynamic>>>, AsyncValue<OptimisticState<dynamic>>, String>((ref, endpoint) {
  // This is a base provider - actual implementation would be per entity type
  // Return a notifier that fetches initial data
  return _BaseOptimisticNotifier(ref, endpoint);
});

class _BaseOptimisticNotifier<T> extends StateNotifier<AsyncValue<OptimisticState<T>>> 
    with OptimisticUpdater<T> {
  final Ref ref;
  @override
  final String endpoint;
  
  _BaseOptimisticNotifier(this.ref, this.endpoint) : super(const AsyncValue.loading()) {
    _fetch();
  }
  
  Future<void> _fetch() async {
    try {
      final data = await ref.read(listQueryProvider(endpoint).future);
      state = AsyncValue.data(OptimisticState(data: data as T));
    } catch (e, st) {
      state = AsyncValue.error(e, st);
    }
  }
}