// State management for {% .ProjectName%}.
// Uses Riverpod for scoped state that syncs across platforms.
// When enabled on both web and mobile, provides synchronized state across platforms.

import 'dart:async';
import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:http/http.dart' as http;

// Base provider for data state
final dataStateProvider = StateProvider<Map<String, dynamic>>(({}));

// Provider to fetch data from API
final dataFetchProvider = FutureProvider<Map<String, dynamic>>((ref) async {
  final String apiBaseUrl = String.fromEnvironment('API_BASE_URL', defaultValue: 'http://10.0.2.2:8000');
  final res = await http.post(
    Uri.parse('$apiBaseUrl/api/data'),
    headers: { 'Content-Type': 'application/json' },
    body: jsonEncode({}),
  );
  
  if (res.statusCode != 200) {
    throw Exception('Failed to fetch data: ${res.statusCode}');
  }
  
  return jsonDecode(res.body) as Map<String, dynamic>;
});

// Provider to mutate data on the server
final dataMutateProvider = FutureProvider.family<Map<String, dynamic>, Map<String, dynamic>>((ref, newData) async {
  final String apiBaseUrl = String.fromEnvironment('API_BASE_URL', defaultValue: 'http://10.0.2.2:8000');
  final res = await http.post(
    Uri.parse('$apiBaseUrl/api/data'),
    headers: { 'Content-Type': 'application/json' },
    body: jsonEncode(newData),
  );
  
  if (res.statusCode != 200) {
    throw Exception('Failed to mutate data: ${res.statusCode}');
  }
  
  return jsonDecode(res.body) as Map<String, dynamic>;
});

// Hook-like function to use state management
Map<String, dynamic> useStateManagement(WidgetRef ref) {
  final data = ref.watch(dataStateProvider);
  final fetchData = ref.watch(dataFetchProvider);
  final mutateData = ref.watch(dataMutateProvider);
  
  return {
    'data': data.value,
    'isLoading': fetchData.isLoading,
    'error': fetchData.error?.toString(),
    'mutateData': mutateData.value,
  };
}